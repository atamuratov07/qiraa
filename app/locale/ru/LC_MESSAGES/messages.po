#, python-format
msgid "Answer %(answer)s is out of range: this question has %(count)s options."
msgstr "Ответа %(answer)s нет: вариантов в этом вопросе всего %(count)s."

#: app/content/errors.py:38
msgid "Use lowercase Latin letters, digits and single hyphens, like b1-media."
msgstr "Используйте строчные латинские буквы, цифры и одиночные дефисы, например b1-media."

#: app/content/errors.py:40
#, python-format
msgid "The slug %(slug)s is used twice in this file."
msgstr "Слаг %(slug)s встречается в файле дважды."

