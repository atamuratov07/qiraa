#: app/content/errors.py:29
#, python-format
msgid "Too long: the limit is %(max_length)s characters."
msgstr "Слишком длинно: не больше %(max_length)s символов."

#: app/content/errors.py:30
#, python-format
msgid "Too few items: at least %(min_length)s are needed."
msgstr "Слишком мало пунктов: нужно не меньше %(min_length)s."

