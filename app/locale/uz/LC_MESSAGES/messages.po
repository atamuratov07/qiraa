#: app/content/errors.py:10
#, python-format
msgid "This is not valid YAML: %(problem)s"
msgstr "Bu yaroqli YAML emas: %(problem)s"

#: app/content/errors.py:12
#, python-format
msgid "The invisible character %(code)s is not allowed. Delete it or retype the line."
msgstr "Koʻrinmas %(code)s belgisiga ruxsat yoʻq. Uni oʻchiring yoki qatorni qayta yozing."

#: app/content/errors.py:15
msgid "Anchors and aliases (& and *) are not allowed. Write the value out in full."
msgstr "Langar va havolalar (& va *) ishlatilmaydi. Qiymatni toʻliq yozing."

#: app/content/errors.py:17
msgid "The lists and blocks are nested too deeply."
msgstr "Roʻyxatlar va bloklar bir-birining ichiga juda chuqur joylashgan."

#: app/content/errors.py:18
#, python-format
msgid "%(key)s appears twice in the same block."
msgstr "%(key)s kaliti bitta blokda ikki marta uchraydi."

#: app/content/errors.py:19
msgid "The file is empty."
msgstr "Fayl boʻsh."

#: app/content/errors.py:20 app/content/errors.py:21
msgid "Expected a block of key: value lines."
msgstr "Bu yerda «kalit: qiymat» koʻrinishidagi qatorlar bloki kerak."

#: app/content/errors.py:22
msgid "Expected a list of items starting with a dash (-)."
msgstr "Bu yerda har bir bandi chiziqcha (-) bilan boshlanadigan roʻyxat kerak."

#: app/content/errors.py:23
#, python-format
msgid "The field %(field)s is missing."
msgstr "%(field)s maydoni yetishmayapti."

#: app/content/errors.py:24
#, python-format
msgid "Unknown field %(field)s. Check the spelling."
msgstr "Nomaʼlum maydon: %(field)s. Yozilishini tekshiring."

#: app/content/errors.py:26
msgid "Expected text. Quote a value that looks like a number, a date, yes or no."
msgstr "Bu yerda matn kerak. Son, sana, yes yoki no ga oʻxshagan qiymatni qoʻshtirnoqqa oling."

#: app/content/errors.py:28
msgid "This can't be empty."
msgstr "Bu boʻsh boʻlishi mumkin emas."

#: app/content/errors.py:29
#, python-format
msgid "Too long: the limit is %(max_length)s characters."
msgstr "Juda uzun: koʻpi bilan %(max_length)s ta belgi."

#: app/content/errors.py:30
#, python-format
msgid "Too few items: at least %(min_length)s are needed."
msgstr "Bandlar juda kam: kamida %(min_length)s ta kerak."

#: app/content/errors.py:31
#, python-format
msgid "Too many items: the limit is %(max_length)s."
msgstr "Bandlar juda koʻp: koʻpi bilan %(max_length)s ta."

#: app/content/errors.py:32
msgid "The answer must be a letter from A to F."
msgstr "Javob A dan F gacha boʻlgan harf boʻlishi kerak."

#: app/content/errors.py:33
#, python-format
msgid "The option %(option)s appears twice."
msgstr "%(option)s varianti ikki marta uchraydi."

#: app/content/errors.py:35
#, python-format
msgid "Answer %(answer)s is out of range: this question has %(count)s options."
msgstr "%(answer)s javobi yoʻq: bu savolda bor-yoʻgʻi %(count)s ta variant."

#: app/content/errors.py:38
msgid "Use lowercase Latin letters, digits and single hyphens, like b1-media."
msgstr ""
"Kichik lotin harflari, raqamlar va yakka chiziqchalardan foydalaning, masalan "
"b1-media."

#: app/content/errors.py:40
#, python-format
msgid "The slug %(slug)s is used twice in this file."
msgstr "%(slug)s slugi faylda ikki marta uchraydi."

#: app/content/errors.py:42
msgid "Someone imported the same content at the same moment. Import the file again."
msgstr "Kimdir aynan shu kontentni xuddi shu paytda import qildi. Faylni qayta import qiling."

#: app/content/errors.py:44
#, python-format
msgid "The file is larger than %(limit)s."
msgstr "Fayl %(limit)s dan katta."

#: app/content/errors.py:45
msgid "The file is not UTF-8 text. Save it as UTF-8 and try again."
msgstr "Fayl UTF-8 kodlashida emas. Uni UTF-8 da saqlang va qaytadan urinib koʻring."

