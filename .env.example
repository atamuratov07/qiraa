# Copy to .env for local development. Never commit the real .env.

# The Postgres from docker-compose.yml, which is also the default. Change it to use another
# database. In production, Neon's connection string, e.g.
# postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://qiraa:qiraa@localhost:5432/qiraa
# MIGRATION_DATABASE_URL=

# true in production (HTTPS). Keep false for http://localhost.
SECURE_COOKIES=false

APP_TIMEZONE=Asia/Tashkent

# Set to false once your own account exists.
ALLOW_SIGNUP=true
